 {"id":"ap-001","topic":"area-perimeter","paper":"reasoning","difficulty":1,"marks":1,"format":"numeric","prompt":"A rectangle is 9 cm long and 4 cm wide. What is its area in cm²?","answer":"36","explanation":"Area = length × width = 9 × 4 = 36.","source":"original","status":"approved"},
 {"id":"ap-002","topic":"area-perimeter","paper":"reasoning","difficulty":1,"marks":1,"format":"numeric","prompt":"A rectangle is 9 cm long and 4 cm wide. What is its perimeter in cm?","answer":"26","explanation":"Perimeter = 2 × (9 + 4) = 26.","source":"original","status":"approved"},
 {"id":"ap-003","topic":"area-perimeter","paper":"reasoning","difficulty":2,"marks":1,"format":"numeric","prompt":"A square has sides of 7 cm. What is its area in cm²?","answer":"49","explanation":"7 × 7 = 49.","source":"original","status":"approved"},
 {"id":"ap-004","topic":"area-perimeter","paper":"reasoning","difficulty":2,"marks":1,"format":"numeric","prompt":"A rectangle has an area of 72 cm² and is 8 cm long. How wide is it in cm?","answer":"9","explanation":"Width = area ÷ length = 72 ÷ 8 = 9.","source":"original","status":"approved"},
 {"id":"ap-005","topic":"area-perimeter","paper":"reasoning","difficulty":2,"marks":1,"format":"numeric","prompt":"A rectangle has a perimeter of 30 cm and is 11 cm long. How wide is it in cm?","answer":"4","explanation":"Length + width = 30 ÷ 2 = 15. So width = 15 − 11 = 4.","source":"original","status":"approved"},
 {"id":"ap-006","topic":"area-perimeter","paper":"reasoning","difficulty":3,"marks":1,"format":"numeric","prompt":"A triangle has a base of 12 cm and a height of 7 cm. What is its area in cm²?","answer":"42","explanation":"Area = base × height ÷ 2 = 12 × 7 ÷ 2 = 42.","source":"original","status":"approved"},
 {"id":"ap-007","topic":"area-perimeter","paper":"reasoning","difficulty":3,"marks":1,"format":"numeric","prompt":"A parallelogram has a base of 15 cm and a height of 6 cm. What is its area in cm²?","answer":"90","explanation":"Area = base × height = 15 × 6 = 90.","source":"original","status":"approved"},
 {"id":"ap-008","topic":"area-perimeter","paper":"reasoning","difficulty":3,"marks":1,"format":"numeric","prompt":"An L-shaped room is made from a 6 m by 5 m rectangle joined to a 4 m by 3 m rectangle. What is the total area in m²?","answer":"42","explanation":"6 × 5 = 30 and 4 × 3 = 12. 30 + 12 = 42.","source":"original","status":"approved"}
