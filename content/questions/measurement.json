 {"id":"mea-001","topic":"measurement","paper":"reasoning","difficulty":1,"marks":1,"format":"numeric","prompt":"How many millimetres are in 3.5 cm?","answer":"35","explanation":"1 cm = 10 mm, so 3.5 × 10 = 35.","source":"original","status":"approved"},
 {"id":"mea-002","topic":"measurement","paper":"reasoning","difficulty":1,"marks":1,"format":"numeric","prompt":"How many grams are in 2.4 kg?","answer":"2400","explanation":"1 kg = 1,000 g, so 2.4 × 1,000 = 2,400.","source":"original","status":"approved"},
 {"id":"mea-003","topic":"measurement","paper":"reasoning","difficulty":1,"marks":1,"format":"numeric","prompt":"How many litres is 750 ml? (Write as a decimal)","answer":"0.75","explanation":"1 litre = 1,000 ml, so 750 ÷ 1,000 = 0.75.","source":"original","status":"approved"},
 {"id":"mea-004","topic":"measurement","paper":"reasoning","difficulty":2,"marks":1,"format":"numeric","prompt":"How many metres are in 3 km 250 m?","answer":"3250","explanation":"3 km = 3,000 m. 3,000 + 250 = 3,250.","source":"original","status":"approved"},
 {"id":"mea-005","topic":"measurement","paper":"reasoning","difficulty":2,"marks":1,"format":"numeric","prompt":"A rope is 4.2 m long. How many centimetres is that?","answer":"420","explanation":"1 m = 100 cm, so 4.2 × 100 = 420.","source":"original","status":"approved"},
 {"id":"mea-006","topic":"measurement","paper":"reasoning","difficulty":3,"marks":1,"format":"numeric","prompt":"A bag holds 1.5 kg of flour. Mia uses 650 g. How many grams are left?","answer":"850","explanation":"1.5 kg = 1,500 g. 1,500 − 650 = 850.","source":"original","status":"approved"},
 {"id":"mea-007","topic":"measurement","paper":"reasoning","difficulty":3,"marks":1,"format":"numeric","prompt":"A ribbon is 2.5 m long. It is cut into pieces that are each 25 cm long. How many pieces are there?","answer":"10","explanation":"2.5 m = 250 cm. 250 ÷ 25 = 10.","source":"original","status":"approved"},
